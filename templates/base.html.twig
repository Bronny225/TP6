<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Gestion des commandes{% endblock %}</title>
</head>
<body>
    <nav>
        <a href="{{ path('app_accueil') }}">Accueil</a>

        {% if app.user %}
            <span>Connecté : {{ app.user.userIdentifier }}</span>
            <a href="{{ path('app_produit') }}">Produits</a>

            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_client') }}">Clients</a>
                <a href="{{ path('app_commande') }}">Commandes</a>
            {% endif %}

            <a href="{{ path('app_logout') }}">Déconnexion</a>
        {% else %}
            <a href="{{ path('app_login') }}">Connexion</a>
            <a href="{{ path('app_register') }}">Inscription</a>
        {% endif %}
    </nav>

    <main>
        {% block body %}{% endblock %}
    </main>
</body>
</html>
